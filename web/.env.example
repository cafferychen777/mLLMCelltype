# mLLMCelltype Web Configuration
# Copy this file to .env and fill in your values

# --- Storage (Turso) ---
TURSO_DB_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# --- Flask ---
FLASK_SECRET_KEY=your_flask_secret_key_here
BACKGROUND_THREADS_ENABLED=true

# --- Admin (optional — admin dashboard is disabled if not set) ---
# Generate hash: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('YOUR_PASSWORD'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
